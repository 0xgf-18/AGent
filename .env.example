# AGent Environment Variables
# Copy this file to .env and fill in your values

# GitHub (for pushing to remote repos)
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=your_username

# Android SDK (for APK analysis tools)
ANDROID_HOME=C:\Users\YourName\AppData\Local\Android\Sdk
ANDROID_SDK_ROOT=C:\Users\YourName\AppData\Local\Android\Sdk

# ADB (for device communication)
ADB_PATH=C:\Users\YourName\AppData\Local\Android\Sdk\platform-tools\adb.exe

# Python
PYTHON_PATH=python

# Agent Configuration
AGENT_LOG_LEVEL=INFO
AGENT_TEMP_DIR=%TEMP%\opencode
AGENT_OUTPUT_DIR=./output

# KB Configuration
KB_ROOT=./knowledge_base
KB_GRAPH_DIR=./knowledge_base/visualizer
KB_ARTICLES_DIR=./knowledge_base/articles
KB_INBOX_DIR=./knowledge_base/inbox

# Tool Configuration
APKTOOL_JAR=./tools/apktool.jar
JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17.0.20.101-hotspot
